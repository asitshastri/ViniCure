{
  "name": "vinicure",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "pnpm build:migrate && node --env-file-if-exists=.env.local dist/migrate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:worker": "esbuild worker/main.mts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.mjs",
    "worker": "pnpm build:worker && node --env-file-if-exists=.env.local dist/worker.mjs",
    "build:migrate": "esbuild db/migrate.mts --bundle --platform=node --format=esm --packages=external --outfile=dist/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/nextjs": "11.2.0",
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
