# Names only. Never put real values in this file. Copy to .env.local for local work.
# Production values come from the secrets manager (see docs/backend-architecture.md section 17).

# App
NODE_ENV=
APP_ENV=
APP_URL=
LOG_LEVEL=
TRUSTED_PROXY_HOPS=
WORKER_HEALTH_PORT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=

# Cache
VALKEY_URL=
VALKEY_TLS=

# Auth
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=
ALLOWED_PHONE_COUNTRY_CODES=

# Google sign-in (patients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Crypto (LOCAL_DEV_KEY is for local development only and is refused in production)
CRYPTO_PROVIDER=
KMS_KEY_ID=
LOCAL_DEV_KEY=

# Storage (S3_ENDPOINT points at MinIO locally and must be empty in production)
S3_BUCKET_FILES=
S3_BUCKET_EXPORTS=
S3_REGION=
S3_ENDPOINT=
SIGNED_URL_TTL_SECONDS=

# Video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
VIDEO_TOKEN_TTL_SECONDS=
VIDEO_JOIN_EARLY_MINUTES=
VIDEO_JOIN_LATE_MINUTES=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS, WhatsApp, email
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SES_REGION=
EMAIL_FROM=

# Scanner
CLAMAV_HOST=
CLAMAV_PORT=

# Captcha
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# AI
AI_API_KEY=
AI_MODEL=
AI_DAILY_BUDGET=

# Feature flags (true or false, all default to false)
FEATURE_AI_TRIAGE=
FEATURE_RECORDING=
FEATURE_REFERRALS=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Budgets
SMS_DAILY_CAP=
