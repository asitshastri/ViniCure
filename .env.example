# Names only. Never put real values in this file. Copy to .env.local for local work.
# Production values come from the secrets manager (see docs/backend-architecture.md section 17).

# App
NODE_ENV=
APP_ENV=
APP_URL=
LOG_LEVEL=
TRUSTED_PROXY_HOPS=
WORKER_HEALTH_PORT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=

# Cache
VALKEY_URL=
VALKEY_TLS=

# Auth
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=
ALLOWED_PHONE_COUNTRY_CODES=

# Google sign-in (patients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Crypto (LOCAL_DEV_KEY is for local development only and is refused in production)
CRYPTO_PROVIDER=
KMS_KEY_ID=
LOCAL_DEV_KEY=

# Storage (S3_ENDPOINT points at MinIO locally and must be empty in production)
S3_BUCKET_FILES=
S3_BUCKET_EXPORTS=
# Recordings only (FEATURE_RECORDING): a separate private bucket in ap-south-1 (Mumbai)
S3_BUCKET_RECORDINGS=
S3_REGION=
S3_ENDPOINT=
SIGNED_URL_TTL_SECONDS=

# Video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
VIDEO_TOKEN_TTL_SECONDS=
VIDEO_JOIN_EARLY_MINUTES=
VIDEO_JOIN_LATE_MINUTES=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test and local work only: send payment calls to a stand-in instead of Razorpay (never in production).
RAZORPAY_API_BASE=
# Platform share of each payment, in hundredths of a percent (1000 = 10%). 0 until the rate is decided.
PLATFORM_FEE_BPS=0
# Invoices: tax included in the fee (hundredths of a percent) and the issuer as printed. Confirm with the accountant.
INVOICE_TAX_BPS=0
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_TAX_ID=

# SMS, WhatsApp, email
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# The OTP template id from the MSG91 dashboard (the message is registered on DLT there)
MSG91_TEMPLATE_OTP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SES_REGION=
EMAIL_FROM=
# Email over SMTP. Local: SMTP_HOST=localhost SMTP_PORT=1025 (Mailpit shows mail at http://localhost:8025).
# Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, your address and an app password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Scanner
CLAMAV_HOST=
CLAMAV_PORT=

# Captcha
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# AI
AI_API_KEY=
AI_MODEL=
AI_DAILY_BUDGET=

# Feature flags (true or false, all default to false)
FEATURE_AI_TRIAGE=
FEATURE_RECORDING=
# Days to keep a recording. A legal decision, so there is no default; recording needs it
RECORDING_RETENTION_DAYS=
FEATURE_REFERRALS=
# Referral reward per person in paise (0 until decided) and the most people one person may refer.
REFERRAL_REWARD_PAISE=0
REFERRAL_MAX_PER_REFERRER=10

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Development only: show pages behind sign-in with mock data and no real session. Refused in production.
UI_MOCK_SESSION=
SENTRY_ENVIRONMENT=

# Budgets
SMS_DAILY_CAP=
